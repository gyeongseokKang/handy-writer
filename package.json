{
  "name": "handy-writer",
  "productName": "Handy Writer",
  "version": "0.1.6",
  "description": "글쓰기를 도와주는 데스크톱 앱",
  "private": true,
  "license": "MIT",
  "author": "gyeongseokKang",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:win": "pnpm build && electron-builder --win",
    "build:linux": "pnpm build && electron-builder --linux",
    "test": "vitest run",
    "test:e2e": "node e2e/app.e2e.mjs",
    "test:unit": "vitest run",
    "test:e2e:ime": "node e2e/ime.e2e.mjs",
    "test:e2e:templates": "node e2e/templates.e2e.mjs",
    "test:e2e:ai-login": "node e2e/ai-login.e2e.mjs",
    "test:e2e:draft": "node e2e/draft.e2e.mjs",
    "test:e2e:log": "node e2e/log.e2e.mjs",
    "test:e2e:tree-menu": "node e2e/tree-menu.e2e.mjs",
    "test:e2e:code-block": "node e2e/code-block.e2e.mjs",
    "test:e2e:spell-panel": "node e2e/spell-panel.e2e.mjs",
    "test:e2e:draft-sources": "node e2e/draft-sources.e2e.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-drag-handle": "^3.32.0",
    "@tiptap/extension-drag-handle-react": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "hanspell": "^1.0.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
